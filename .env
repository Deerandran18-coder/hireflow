# Server
PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Optional: real AI resume scoring via Claude API. If unset, a heuristic
# skill/experience matcher is used instead (fully functional, no key needed).
ANTHROPIC_API_KEY=

# Optional: real SMTP email sending. If unset, emails are logged to the
# console and recorded in the notifications table (mock transport).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ATS Platform <noreply@yourcompany.com>"
